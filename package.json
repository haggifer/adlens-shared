{
    "name": "adlens-shared",
    "version": "0.4.0",
    "description": "AdLens API contract: Zod schemas (source of truth) and inferred types for the web app and the API",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/haggifer/adlens-shared.git"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint .",
        "test": "node --test test/*.test.mjs",
        "check:package": "npx --yes publint && npx --yes @arethetypeswrong/cli --pack .",
        "prepublishOnly": "npm run build",
        "changeset": "changeset",
        "version-packages": "changeset version"
    },
    "peerDependencies": {
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^9.39.5",
        "eslint": "^9.39.5",
        "tsup": "^8.5.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.70.1",
        "zod": "^4.4.3"
    }
}
